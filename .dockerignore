# Everything here is bind-mounted at runtime (docker-compose.yml) or not needed in the image.
# data/ holds the live DB and the APK; static/faces/ holds the kids' photos from Immich.
# None of it belongs in an image layer.
.git
data/
logs/
android/
src/fun_forge/static/faces/
src/fun_forge/static/covers/
**/__pycache__
*.db
*.db.backup
