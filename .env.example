# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real key here.

# Parent lock PIN (toddler lock, not a security boundary)
PARENT_PIN=1234

# --- Immich, for the family photo games -------------------------------------
# Only scripts/sync_immich_faces.py reads these, and it runs on the HOST, not in
# the container: FunForge's container is on its own bridge and cannot reach
# Immich, and keeping the app itself offline from Immich means the games still
# work when Immich is down or being upgraded.
#
# IMMICH_API_KEY comes from Immich: Account Settings -> API Keys -> New API Key.
IMMICH_URL=http://10.0.0.160:2283
IMMICH_API_KEY=
# Named people to pull, exactly as they are spelled in Immich's People page.
IMMICH_PEOPLE=Weston,Rowan
# How many photos per person to cache.
IMMICH_PHOTOS_PER_PERSON=40
